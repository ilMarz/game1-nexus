# Solo server: non usare un prefisso VITE_ per la chiave.

# Jev: API server TypeSafe, nessun modello sul dispositivo.
TYPESAFE_API_KEY=your_typesafe_key_here
TYPESAFE_MODEL=jev-1.14.0
# auto usa Jev; senza chiave valida il gioco applica regole locali.
AI_PROVIDER=auto
# true oppure ON blocca tutte le modalità e mostra "Limite JEV raggiunto". Assente o false: gioco disponibile.
ENABLE_LIMIT=false
